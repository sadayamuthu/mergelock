Negative: a adds an optional parameter, so b's old-shape call still compiles.
-- base/src/auth.ts --
export function login(name: string, email: string): string {
  return name + email;
}
-- base/src/users.ts --
export function listUsers(): string[] {
  return [];
}
-- a/src/auth.ts --
export function login(name: string, email: string, remember?: boolean): string {
  return remember ? name : name + email;
}
-- b/src/users.ts --
import { login } from "./auth";

export function listUsers(): string[] {
  return [];
}

export function createUser(): string {
  return login("ann", "ann@example.com");
}
-- expected.json --
{"result": "clean", "findings": []}
