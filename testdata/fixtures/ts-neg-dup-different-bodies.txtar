-- base/src/index.ts --
export const version = "1";
-- a/src/sum.ts --
export function summarize(xs: number[], limit: number): number {
  let total = 0;
  let count = 0;
  for (const x of xs) {
    if (x > limit) {
      continue;
    }
    total += x * 2;
    count += 1;
  }
  return count === 0 ? 0 : total / count;
}
-- b/src/caps.ts --
export function normalizeTitle(s: string): string {
  const parts = s.trim().split(" ");
  const out: string[] = [];
  while (parts.length > 0) {
    const word = parts.shift() as string;
    if (word.length === 0) {
      continue;
    }
    out.push(word[0].toUpperCase() + word.slice(1).toLowerCase());
  }
  return out.join(" ");
}
