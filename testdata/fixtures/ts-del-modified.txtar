a deletes a method that b edits: git sees a textual conflict, mergelock names the symbol.
-- base/src/auth.ts --
export class AuthService {
  login(name: string): string {
    return name;
  }

  refresh(token: string): string {
    return token;
  }
}
-- a/src/auth.ts --
export class AuthService {
